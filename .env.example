# Copy this file to .env and fill in your own lab values.
# .env is git-ignored. Never commit real credentials to a public repository.
#
# Linux/macOS:   set -a; source .env; set +a
# Windows (PS):  Get-Content .env | Where-Object { $_ -notmatch '^\s*#|^\s*$' } |
#                ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k,$v) }

# --- Device connection (referenced by testbed.yaml via %ENV{}) ---------------
# Management IP only: no scheme, no trailing slash. Example: 192.0.2.10
CML_DEVICE_IP=
CML_DEVICE_USERNAME=
CML_DEVICE_PASSWORD=
CML_DEVICE_ENABLE_PASSWORD=

# --- Server configuration ----------------------------------------------------
# Absolute path to your testbed file.
PYATS_TESTBED=/absolute/path/to/testbed/testbed.yaml

# Write operations are OFF by default. Enable only in a lab you own.
PYATS_MCP_ALLOW_CONFIG=false
# Saving to startup-config requires this in addition to PYATS_MCP_ALLOW_CONFIG.
PYATS_MCP_ALLOW_SAVE=false

# Optional comma-separated allow-list. Empty means every device in the testbed.
PYATS_MCP_ALLOWED_DEVICES=

# Timeouts in seconds and the per-response output cap in characters.
PYATS_MCP_CONNECT_TIMEOUT=60
PYATS_MCP_COMMAND_TIMEOUT=120
PYATS_MCP_MAX_OUTPUT_CHARS=60000

# SSH host key verification is ON by default. Set to true only for throwaway labs.
PYATS_MCP_INSECURE_SSH=false
# Optional custom known_hosts file used when host key checking is enabled.
PYATS_MCP_KNOWN_HOSTS=
